<?xml version="1.0"?>
<package format="3">
  <name>dual_lidar_calibration</name>
  <version>0.1.0</version>
  <description>Offline extrinsic calibration from synchronized dual Livox LiDAR and IMU data.</description>
  <maintainer email="maintainer@example.com">sentry-navi maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>livox_ros_driver2</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>sensor_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
