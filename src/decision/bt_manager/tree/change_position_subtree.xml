<root BTCPP_format="4">
  <BehaviorTree ID="ChangePositionTree">
    <Fallback>

      <!-- 切换移动姿态1（若已是应保持不变,感觉可以用precondition节点（09）来读取黑板中表示状态的变量，相等就跳过切换,从pbb那里实时更新）2状态切换有五秒cd在想加在哪里（delay装饰器？）3 切姿态后地盘功率减半我们这边从电控拿电容储量信息然后控我们的速度上限？  4请注意黑板条目相互独立，必须进行端口重映射（global_blackboard?） -->
      <Sequence name="MovePosition">
        <CheckMPCondition name="CheckMPCondition" />
        <CheckWhetherChange name="CheckWhetherChange" />
        <ChangePosition name="ChangePosition">
     </Sequence>

      <!-- 切换进攻姿态 -->
      <Sequence name="AttackPosition">
        <CheckAPCodition name="CheckAPCondition"/>
        <CheckWhetherChange name="CheckWhetherChange" />
        <ChangePosition name="ChangePosition">
      </Sequence>
      
      <!-- 切换防御姿态 -->
      <Sequence name="DefendPosition">
        <CheckDPCondition name="CheckDPCondition"/>
        <CheckWhetherChange name="CheckWhetherChange" />
        <ChangePosition name="ChangePosition">
      </Sequence>   
    </Fallback>
  </BehaviorTree>
</root>