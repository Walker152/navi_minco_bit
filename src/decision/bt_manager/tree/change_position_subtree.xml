<root BTCPP_format="4">
  <BehaviorTree ID="ChangePositionTree">
    <Fallback>
      <Sequence name="MoveStance">
        <CheckMPCondition name="CheckMPCondition" desired_stance="{move_desired_stance}" />
        <ChangeStance name="ChangeStanceMove" desired_stance="{move_desired_stance}" />
      </Sequence>

      <Sequence name="AttackStance">
        <CheckAPCondition name="CheckAPCondition" desired_stance="{attack_desired_stance}" />
        <ChangeStance name="ChangeStanceAttack" desired_stance="{attack_desired_stance}" />
      </Sequence>

      <Sequence name="DefendStance">
        <CheckDPCondition name="CheckDPCondition" desired_stance="{defend_desired_stance}" />
        <ChangeStance name="ChangeStanceDefend" desired_stance="{defend_desired_stance}" />
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>