<root main_tree_to_execute="GimbalTree">
  <BehaviorTree ID="GimbalTree">
    <ReactiveFallback name="GimbalPriorityRoot">
      <ReactiveSequence name="Priority1HardLock">
        <CheckTargetVisible name="CheckTargetVisible" branch="Priority1HardLock" />
        <TrackTargetAction name="TrackTargetAction" />
      </ReactiveSequence>

      <ReactiveSequence name="Priority2SpecialResponseScan">
        <CheckOutpostSafeResponse name="CheckOutpostSafeResponseForGimbal"
                                  stable_seconds="5.0"
                                  require_response_mode="true"
                                  branch="Priority2SpecialResponseScan" />
        <CheckNearEnemyOutpost name="CheckNearEnemyOutpost" branch="Priority2SpecialResponseScan" />
        <SetGimbalPose name="SetOutpostInspectPose" pan="0.0" tilt="18.0" />
      </ReactiveSequence>

      <SetGimbalPoseByAreaAction name="SetGimbalPoseByAreaAction" />
    </ReactiveFallback>
  </BehaviorTree>
</root>