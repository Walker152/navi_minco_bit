        <CheckNearEnemyOutpost name="CheckNearEnemyOutpost" branch="Priority2SpecialResponseScan" />
        <SetGimbalPose name="SetOutpostInspectPose" mode="0"/>
      </ReactiveSequence>
      <SetGimbalPose name="SetNormalInspectPose" mode="1" />
