<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="SentryMainLogic">
      <ReactiveSequence name="BlackboardTest">
        <BlackboardTestNode name="BlackboardTestNode" />
      </ReactiveSequence> -->

      <!-- 导航策略 -->
      <ReactiveFallback name="NavigationStrategies">
        <!-- <Sequence name="StairsEvacuation">
          <CheckRetreatCondition name="CheckRetreatCondition" health_threshold="50" recovery_threshold="80"/>
          <CheckInStairsZone name="CheckInStairsZone"/>
          <SetStairsPosition name="SetStairsPosition"/>
          <NavigateToPoseAction name="PublishPreStairsGoal"/>
          <DirectVelocityControl name="DescendStairs"
                                linear_y="2.0"
                                angular_z="0.0"
                                duration="1.5"/>
          <DirectVelocityControl name="StopAfterStairs"
                                linear_y="0.0"
                                angular_z="0.0"
                                duration="0.5"/>
        </Sequence>
         -->

        <!-- 紧急撤退,优先级最高 -->
        <ReactiveSequence name="EmergencyRetreat">
          <CheckRetreatCondition name="CheckRetreatCondition" health_threshold="50" recovery_threshold="80"/>
          <ChangeMapAction name="ChangeMapToBack"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026_back" />
          <SetCoordinate name="SetHomeCoordinate" goal="0" />
          <ForceSuccess>
            <CheckWillThroughTunnel name="CheckWillThroughTunnel" />
          </ForceSuccess>
          <NavigateToPoseAction name="PublishRetreatGoal" />
        </ReactiveSequence>

        <!-- 特殊事件响应节点 -->
        <ReactiveFallback name="SpecialEventResponse">
          <ReactiveSequence name="OutpostResponse">
            <CheckOutpostRemained name="CheckOutpostRemained" />
            <SetCoordinate name="SetResponseCoordinate" goal="2" />
            <NavigateToPoseAction name="PublishResponseGoal" />
          </ReactiveSequence>
        </ReactiveFallback>

        <!-- 进攻根节点 -->
        <ReactiveSequence name="OffensiveRoot">
          <ChangeMapAction name="ChangeMapToMain"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026" />

          <ReactiveFallback name="OffensiveStrategies">
            <!-- 追击模式，在区域内自动追击 -->
            <ReactiveSequence name="TargetPursuit">
              <CheckTargetLocked name="CheckTargetLocked" />
              <SetTargetCoordinate name="SetTargetCoordinate" />
              <NavigateToPoseAction name="PublishPursuitGoal" />
            </ReactiveSequence>

            <!-- 普通巡逻模式 -->
            <Sequence name="RegularPatrol">
              <SelectPatrolPoint name="SelectPatrolPoint" />
                <ReactiveSequence name="NavigationAndTunnelCheck">
                  <ForceSuccess>
                    <CheckWillThroughTunnel name="CheckWillThroughTunnel" />
                  </ForceSuccess> 
                  <NavigateToPoseAction name="PublishPatrolGoal" />
                </ReactiveSequence>
              <!-- <NavigateToPoseAction name="PublishPatrolGoal" /> -->
              <Wait name="PostNavigationWait" />
            </Sequence>
          </ReactiveFallback><!--OffensiveStrategies-->
        </ReactiveSequence><!--OffensiveRoot-->
      </ReactiveFallback><!--NavigationStrategies-->
    </ReactiveSequence><!--NavigationRoot-->
  </BehaviorTree>
</root>