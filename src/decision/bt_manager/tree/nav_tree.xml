<root main_tree_to_execute="MainTree">
  <include path="recovery_tree.xml" />
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="MainReactiveSequence">
      <ForceSuccess>
        <CheckTargetLocked name="CheckEarlyTargetLocked" branch="EarlyTargetAttack" />
      </ForceSuccess>
      <ForceSuccess>
        <!-- 每 tick 更新自动前哨攻击/撤退状态，不能被导航优先级分支短路。 -->
        <UpdateOutpostAttackState name="UpdateOutpostAttackState"
                                  retreat_health_threshold="25"
                                  recovery_health_threshold="90"
                                  enhanced_defend_seconds="5.0"
                                  max_retreat_count="3"
                                  branch="OutpostAttackState" />
      </ForceSuccess>
      <ForceSuccess>
        <ReactiveSequence name="AutoHeroGuardEnableWindow">
          <CheckGameTimeWindow name="CheckAutoHeroGuardEnableWindow"
                               min_remaining="260"
                               max_remaining="280"
                               branch="AutoHeroGuardEnableWindow" />
          <SetHeroGuardActive name="SetAutoHeroGuardActive"
                              active="true"
                              branch="AutoHeroGuardEnableWindow" />
        </ReactiveSequence>
      </ForceSuccess>
      <ForceSuccess>
        <ReactiveSequence name="AutoHeroGuardDisableWindow">
          <CheckGameTimeWindow name="CheckAutoHeroGuardDisableWindow"
                               min_remaining="180"
                               max_remaining="190"
                               require_game_started="false"
                               branch="AutoHeroGuardDisableWindow" />
          <SetHeroGuardActive name="SetAutoHeroGuardInactive"
                              active="false"
                              exit_nav_mode="true"
                              branch="AutoHeroGuardDisableWindow" />
        </ReactiveSequence>
      </ForceSuccess>
      <ForceSuccess>
        <UpdateHighlandFallbackState name="UpdateHighlandFallbackState"
                                     cutoff_remaining="340"
                                     branch="HighlandFallbackState" />
      </ForceSuccess>
      <ReactiveFallback name="NavPriorityRoot">
        <!-- <ReactiveSequence name="Priority0EmergencyStop">
          <EmergencyStop name="EmergencyStop" enable_combat_stop="false" />
          <NavigateToPoseAction name="NavigateEmergencyStop" />
        </ReactiveSequence> -->

        <SubTree ID="TunnelRecoverySubTree"
                 __shared_blackboard="true"
                 __autoremap="true" />

        <!-- 前哨专项撤退一旦触发就保持高优先级；回血至上限且5秒防御结束后退出。 -->
        <ReactiveSequence name="Priority0OutpostHealthRecovery">
          <CheckOutpostAttackState name="CheckOutpostRetreatActive"
                                   state="retreat"
                                   branch="Priority0OutpostHealthRecovery" />
          <SetNavMode name="SetOutpostHealthRetreatNavMode" mode="retreat" />
          <SetCoordinate name="SetOutpostHealthHomeGoal" goal="0" />
          <NavigateToPoseAction name="NavigateOutpostHealthHome" />
        </ReactiveSequence>

        <ReactiveSequence name="HighlandFallbackLine">
          <CheckHighlandFallbackActive name="CheckHighlandFallbackActive"
                                       branch="HighlandFallbackLine" />
          <!-- 兜底分支必须闭合:内部导航失败时也不能落回原出门逻辑。 -->
          <ForceSuccess>
            <ReactiveFallback name="HighlandFallbackPriority">
              <ReactiveSequence name="FallbackManualOverride">
                <CheckManualOverride name="CheckFallbackManualOverride"
                                     branch="FallbackManualOverride" />
                <ReactiveFallback name="FallbackManualGoalSelector">
                  <ReactiveSequence name="FallbackManualAttackFortResponse">
                    <CheckTacticalModeCondition name="CheckFallbackManualAttackMode"
                                                mode="attack"
                                                branch="FallbackManualAttackFortResponse" />
                    <SetCoordinate name="SetFallbackManualEnemyFortGoal" goal="4" />
                    <ForceSuccess>
                      <NavigateToPoseAction name="NavigateFallbackManualEnemyFort" />
                    </ForceSuccess>
                  </ReactiveSequence>
                  <ReactiveSequence name="FallbackManualPointResponse">
                    <SetManualOverrideGoal name="SetFallbackManualOverrideGoal"
                                           wait_duration_s="10.0"
                                           goal_radius="0.5"
                                           fallback_timeout_s="60.0" />
                    <ForceSuccess>
                      <NavigateToPoseAction name="NavigateFallbackManualOverrideGoal" />
                    </ForceSuccess>
                  </ReactiveSequence>
                </ReactiveFallback>
              </ReactiveSequence>

              <ReactiveSequence name="FallbackHealthRecovery">
                <CheckRetreatCondition name="CheckFallbackHealthRecoveryCondition"
                                       health_threshold="40"
                                       recovery_threshold="90"
                                       branch="FallbackHealthRecovery" />
                <SetNavMode name="SetFallbackHealthRetreatNavMode" mode="retreat" />
                <SetCoordinate name="SetFallbackHealthHomeGoal" goal="0" />
                <ForceSuccess>
                  <NavigateToPoseAction name="NavigateFallbackHealthHome" />
                </ForceSuccess>
              </ReactiveSequence>

              <ReactiveSequence name="FallbackAmmoSupply">
                <CheckAmmoLow ammo_threshold="50" branch="FallbackAmmoSupply" />
                <SetNavMode name="SetFallbackAmmoRetreatNavMode" mode="retreat" />
                <SetCoordinate name="SetFallbackAmmoHomeGoal" goal="0" />
                <ForceSuccess>
                  <NavigateToPoseAction name="NavigateFallbackAmmoHome" />
                </ForceSuccess>
              </ReactiveSequence>

              <ReactiveSequence name="FallbackHeroGuard">
                <SetNavMode name="SetFallbackHeroGuardNavMode" mode="response" />
                <SetCoordinate name="SetFallbackHeroGuardCoordinate" goal="6" />
                <ForceSuccess>
                  <NavigateToPoseAction name="NavigateFallbackHeroGuard" />
                </ForceSuccess>
              </ReactiveSequence>
            </ReactiveFallback>
          </ForceSuccess>
        </ReactiveSequence>

        <ReactiveSequence name="Priority0ManualOverride">
          <CheckManualOverride name="CheckManualOverride" branch="Priority0ManualOverride" />
          <ReactiveFallback name="ManualGoalSelector">
            <ReactiveSequence name="ManualAttackFortResponse">
              <CheckTacticalModeCondition name="CheckManualAttackMode" mode="attack" branch="ManualAttackFortResponse" />
              <SetCoordinate name="SetManualEnemyFortGoal" goal="4" />
              <NavigateToPoseAction name="NavigateManualEnemyFort" />
            </ReactiveSequence>
            <ReactiveSequence name="ManualPointResponse">
              <SetManualOverrideGoal name="SetManualOverrideGoal"
                                     wait_duration_s="10.0"
                                     goal_radius="0.5"
                                     fallback_timeout_s="60.0" />
              <NavigateToPoseAction name="NavigateManualOverrideGoal" />
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <!-- 自动前哨攻击优先于通用40血撤退，确保XML中的25血专项阈值实际生效。 -->
        <ReactiveSequence name="Priority1AutoOutpostAttack">
          <CheckOutpostAttackState name="CheckAutoOutpostAttackActive"
                                   state="auto_attack"
                                   branch="Priority1AutoOutpostAttack" />
          <CheckTacticalModeCondition name="CheckAutoOutpostStrategyNormalMode"
                                      mode="normal"
                                      branch="Priority1AutoOutpostAttack" />
          <SetNavMode name="SetAutoOutpostResponseNavMode" mode="response" />
          <SetCoordinate name="SetAutoEnemyOutpostGoal" goal="2" />
          <NavigateToPoseAction name="NavigateAutoEnemyOutpost" />
        </ReactiveSequence>

        <ReactiveSequence name="Priority1AttackEnemyFortAfter2Min">
          <CheckTacticalModeCondition name="CheckAttackEnemyFortTacticalMode"
                                      mode="attack"
                                      branch="Priority1AttackEnemyFortAfter2Min" />
          <SetNavMode name="SetAttackEnemyFortNavMode" mode="response" />
          <SetCoordinate name="SetAttackEnemyFortGoal" goal="4" />
          <NavigateToPoseAction name="NavigateAttackEnemyFort" />
        </ReactiveSequence>

        <ReactiveSequence name="Priority2MidSupplyWindow">
          <CheckGameTimeWindow name="CheckMidSupplyWindow"
                               min_remaining="150"
                               max_remaining="180"
                               require_game_started="false"
                               branch="Priority2MidSupplyWindow" />
          <ReactiveFallback name="MidSupplySelector">
            <ReactiveSequence name="MidHealthSupply">
              <CheckRetreatCondition name="CheckMidHealthSupplyCondition"
                                     health_threshold="50"
                                     recovery_threshold="90"
                                     branch="MidHealthSupply" />
              <SetNavMode name="SetMidHealthRetreatNavMode" mode="retreat" />
              <SetCoordinate name="SetMidHealthHomeGoal" goal="0" />
              <NavigateToPoseAction name="NavigateMidHealthHome" />
            </ReactiveSequence>

            <ReactiveSequence name="MidAmmoSupply">
              <CheckAmmoLow ammo_threshold="100" branch="MidAmmoSupply" />
              <ReactiveFallback name="MidAmmoSupplyZoneSelector">
                <!-- <ReactiveSequence name="MidHighlandOutpostSupply">
                  <CheckInZone zone_name="highland" branch="MidHighlandOutpostSupply" />
                  <CheckOwnOutpostAlive branch="MidHighlandOutpostSupply" />
                  <SetCoordinate name="SetMidSupplyOutpostGoal" goal="5" />
                  <NavigateToPoseAction name="NavigateMidSupplyOutpost" />
                </ReactiveSequence> -->

                <ReactiveSequence name="MidOwnDefenseHomeSupply">
                  <!-- <Inverter>
                    <CheckInZone zone_name="enemy_defense" branch="MidOwnDefenseHomeSupply" />
                  </Inverter> -->
                  <SetNavMode name="SetMidAmmoRetreatNavMode" mode="retreat" />
                  <SetCoordinate name="SetMidOwnDefenseSupplyHomeGoal" goal="0" />
                  <NavigateToPoseAction name="NavigateMidOwnDefenseSupplyHome" />
                </ReactiveSequence>
              </ReactiveFallback>
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveSequence name="Priority3GlobalResourceAndEarlySpecial">
          <ReactiveFallback name="GlobalResourceAndEarlySpecialSelector">
            <ReactiveSequence name="GlobalHealthRecovery">
              <CheckRetreatCondition name="CheckGlobalHealthRecoveryCondition"
                                     health_threshold="40"
                                     recovery_threshold="90"
                                     branch="GlobalHealthRecovery" />
              <SetNavMode name="SetGlobalHealthRetreatNavMode" mode="retreat" />
              <SetCoordinate name="SetGlobalHealthHomeGoal" goal="0" />
              <NavigateToPoseAction name="NavigateGlobalHealthHome" />
            </ReactiveSequence>

            <ReactiveSequence name="GlobalAmmoSupply">
              <CheckAmmoLow ammo_threshold="50" branch="GlobalAmmoSupply" />
              <ReactiveFallback name="GlobalAmmoSupplyZoneSelector">
                <!-- <ReactiveSequence name="GlobalOutpostAmmoSupply">
                  <ReactiveFallback>
                    <CheckInZone zone_name="highland" branch="GlobalOutpostAmmoSupply" />
                    <CheckInZone zone_name="own_outpost" branch="GlobalOutpostAmmoSupply" />
                  </ReactiveFallback>
                  <CheckOwnOutpostAlive branch="GlobalOutpostAmmoSupply" />
                  <SetCoordinate name="SetGlobalAmmoOutpostGoal" goal="5" />
                  <NavigateToPoseAction name="NavigateGlobalAmmoOutpost" />
                </ReactiveSequence> -->

                <ReactiveSequence name="GlobalHomeAmmoSupply">
                  <!-- <Inverter>
                    <CheckInZone zone_name="enemy_defense" branch="GlobalHomeAmmoSupply" />
                  </Inverter> -->
                  <SetNavMode name="SetGlobalAmmoRetreatNavMode" mode="retreat" />
                  <SetCoordinate name="SetGlobalAmmoHomeGoal" goal="0" />
                  <NavigateToPoseAction name="NavigateGlobalAmmoHome" />
                </ReactiveSequence>
              </ReactiveFallback>
            </ReactiveSequence>

            <ReactiveSequence name="NormalHeroGuardResponse">
              <CheckHeroGuardActive name="CheckHeroGuardActive"
                                    branch="NormalHeroGuardResponse" />
              <SetCoordinate name="SetHeroGuardCoordinate" goal="6" />
              <ForceSuccess>
                <NavigateToPoseAction name="NavigateHeroGuard" />
              </ForceSuccess>
            </ReactiveSequence>

            <!-- <ReactiveSequence name="EarlyTargetAttack">
              <ReactiveSequence name="EarlyTargetPursuit">
                <CheckTargetLocked name="CheckEarlyTargetLocked" branch="EarlyTargetAttack" />
                <SetTargetCoordinate name="SetEarlyTargetCoordinate" tracing_dist="1.0"/>
                <NavigateToPoseAction name="NavigateEarlyTrackingTarget" />
              </ReactiveSequence>
            </ReactiveSequence> -->

            <ReactiveSequence name="EarlyGameSpecialResponse">
              <CheckGameTimeWindow name="CheckEarlyGameSpecialWindow"
                                   min_remaining="0"
                                   max_remaining="420"
                                   require_game_started="false"
                                   branch="EarlyGameSpecialResponse" />
              <ReactiveFallback name="EarlyGameSpecialSelector">
                <ReactiveSequence name="AutoNormalOutpostResponse">
                  <CheckTacticalModeCondition name="CheckAutoOutpostNormalMode" mode="normal" branch="AutoNormalOutpostResponse" />
                  <CheckOutpostAttackState name="CheckManualOutpostAttackActive"
                                           state="manual_attack"
                                           branch="AutoNormalOutpostResponse" />
                  <SetNavMode name="SetEarlyOutpostResponseNavMode" mode="response" />
                  <SetCoordinate name="SetEarlyEnemyOutpostGoal" goal="2" />
                  <NavigateToPoseAction name="NavigateEarlyEnemyOutpost" />
                </ReactiveSequence>

                <ReactiveSequence name="EarlyDefendFortResponse">
                  <CheckTacticalModeCondition name="CheckEarlyDefendMode" mode="defend" branch="EarlyDefendFortResponse" />
                  <CheckOwnFortIdle name="CheckEarlyOwnFortIdle" branch="EarlyDefendFortResponse" />
                  <SetNavMode name="SetEarlyFortResponseNavMode" mode="response" />
                  <SetCoordinate name="SetEarlyOwnFortGoal" goal="3" />
                  <NavigateToPoseAction name="NavigateEarlyOwnFort" />
                </ReactiveSequence>
              </ReactiveFallback>
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveSequence name="Priority5TrackPatrol">
          <ReactiveFallback name="PatrolSelector">
            <Sequence name="PatrolByTacticalMode">
              <CheckGameTimeWindow name="CheckPatrolNormalWindow"
                                   min_remaining="360"
                                   max_remaining="420"
                                   require_game_started="false"
                                   branch="Priority5TrackPatrol" />
              <!-- <SelectPatrolPoint name="SelectPatrolPoint" patrol_branch_defensive="0"
                                                          patrol_branch_balanced="0"
                                                          patrol_branch_offensive="0"/> -->
              <SelectPatrolPoint name="SelectPatrolPoint" patrol_branch="1" />
              <NavigateToPoseAction name="NavigatePatrolPoint" />
              <Wait name="WaitAtPatrolPoint" />
            </Sequence>
            <Sequence name="PatrolByTacticalMode">
              <CheckGameTimeWindow name="CheckPatrolAttackWindow"
                                   min_remaining="0"
                                   max_remaining="360"
                                   require_game_started="false"
                                   branch="Priority5TrackPatrol" />
              <!-- <SelectPatrolPoint name="SelectPatrolPoint" patrol_branch_defensive="0"
                                                          patrol_branch_balanced="0"
                                                          patrol_branch_offensive="0"/> -->
              <SelectPatrolPoint name="SelectPatrolPoint" patrol_branch="1" />
              <NavigateToPoseAction name="NavigatePatrolPoint" />
              <Wait name="WaitAtPatrolPoint" />
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
