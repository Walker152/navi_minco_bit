<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="NavPriorityRoot">
      <ReactiveSequence name="Priority0ManualOverride">
        <CheckManualOverride name="CheckManualOverride" timeout_seconds="4.0" same_goal_eps="0.05" />
        <ChangeMapAction name="SwitchToMainMapForManual"
                         map_dir="src/navigation/navi2_bringup/maps/2026"
                         pcd_dir="src/utils/pcd2esdf/maps"
                         map_name="rmuc2026" />
        <SetManualOverrideGoal name="SetManualOverrideGoal" />
        <NavigateToPoseAction name="NavigateManualOverrideGoal" />
      </ReactiveSequence>

      <ReactiveSequence name="Priority1Survival">
        <CheckRetreatCondition name="CheckRetreatCondition"
                               health_threshold="30"
                               recovery_threshold="80"
                               ammo_threshold="0"
                               ammo_recovery_threshold="0" />
        <!-- <ChangeMapAction name="SwitchToRetreatMap"
                         map_dir="src/navigation/navi2_bringup/maps/2026"
                         pcd_dir="src/utils/pcd2esdf/maps"
                         map_name="rmuc2026_back" /> -->
        <SetCoordinate name="SetHomeGoal" goal="0" />
        <NavigateToPoseAction name="NavigateHome" />
        <!-- <ForceSuccess>
          <ReactiveSequence name="StairsDescentFlow">
            <CheckInStairsZone name="CheckInStairsZone" />
            <SetStairsPosition name="SetStairsPosition" />
            <CheckNoAllyBelowStairs name="CheckNoAllyBelowStairs" />
            <DescendStairsAction name="DescendStairsAction" linear_y="2.0"
                         angular_z="0.0"
                         timeout="5.0" />
            <DescendStairsAction name="DescendStairsAction" linear_y="0.0"
                         angular_z="0.0"
                         timeout="0.5" />
          </ReactiveSequence>
        </ForceSuccess> -->
        <ForceSuccess>
          <CheckWillThroughTunnel name="CheckWillThroughTunnelForOwnFort" />
        </ForceSuccess>
        <ForceSuccess>
          <ReactiveSequence name="AmmoBuyFlow">
            <CheckAmmoLow name="CheckAmmoLow" ammo_threshold="100" />
            <AccumulateAmmoPurchase name="AccumulateAmmoPurchase" step="30" />
          </ReactiveSequence>
        </ForceSuccess>
      </ReactiveSequence>

      <ReactiveSequence name="Priority2SpecialResponse">
        <!-- <ChangeMapAction name="SwitchToMainMapForSpecial"
                         map_dir="src/navigation/navi2_bringup/maps/2026"
                         pcd_dir="src/utils/pcd2esdf/maps"
                         map_name="rmuc2026" /> -->
        <ReactiveFallback name="SpecialResponseSelector">
          <ReactiveSequence name="NormalOutpostResponse">
            <CheckTacticalModeCondition name="CheckNormalMode" mode="normal" />
            <CheckOutpostSafeResponse name="CheckOutpostSafeResponseForNav"
                                      stable_seconds="5.0"
                                      health_drop_threshold="0.5"
                                      health_change_eps="0.1"
                                      require_response_mode="false" />
            <CheckOutpostRemained name="CheckOutpostRemained" />
            <SetCoordinate name="SetEnemyOutpostGoal" goal="2" />
            <ForceSuccess>
              <CheckWillThroughTunnel name="CheckWillThroughTunnelForOutpost" />
            </ForceSuccess>
            <NavigateToPoseAction name="NavigateEnemyOutpost" />
          </ReactiveSequence>

          <ReactiveSequence name="DefendFortResponse">
            <CheckTacticalModeCondition name="CheckDefendMode" mode="defend" />
            <CheckOwnFortIdle name="CheckOwnFortIdle" />
            <SetCoordinate name="SetOwnFortGoal" goal="3" />
            <ForceSuccess>
              <CheckWillThroughTunnel name="CheckWillThroughTunnelForOwnFort" />
            </ForceSuccess>
            <NavigateToPoseAction name="NavigateOwnFort" />
          </ReactiveSequence>

          <ReactiveSequence name="AttackFortResponse">
            <CheckTacticalModeCondition name="CheckAttackMode" mode="attack" />
            <CheckEnemyBaseLowHp name="CheckEnemyBaseLowHp" threshold="1000" />
            <SetCoordinate name="SetEnemyFortGoal" goal="4" />
            <ForceSuccess>
              <CheckWillThroughTunnel name="CheckWillThroughTunnelForEnemyFort" />
            </ForceSuccess>
            <NavigateToPoseAction name="NavigateEnemyFort" />
          </ReactiveSequence>
        </ReactiveFallback>
      </ReactiveSequence>

      <ReactiveSequence name="Priority3TrackPatrol">
        <!-- <ChangeMapAction name="SwitchToMainMapForRoutine"
                         map_dir="src/navigation/navi2_bringup/maps/2026"
                         pcd_dir="src/utils/pcd2esdf/maps"
                         map_name="rmuc2026" /> -->
        <ReactiveFallback name="TrackPatrolSelector">
          <ReactiveSequence name="TargetPursuit">
            <CheckTargetLocked name="CheckTargetLocked" />
            <SetTargetCoordinate name="SetTargetCoordinate" />
            <ForceSuccess>
              <CheckWillThroughTunnel name="CheckWillThroughTunnelForTracking" />
            </ForceSuccess>
            <NavigateToPoseAction name="NavigateTrackingTarget" />
          </ReactiveSequence>

          <Sequence name="PatrolByTacticalMode">
            <SelectPatrolPoint name="SelectPatrolPoint" />
            <ForceSuccess>
              <CheckWillThroughTunnel name="CheckWillThroughTunnelForPatrol" />
            </ForceSuccess>
            <NavigateToPoseAction name="NavigatePatrolPoint" />
            <Wait name="WaitAtPatrolPoint" />
          </Sequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>