<root main_tree_to_execute="MainTree">
  <include path="recovery_tree.xml" />
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="MainReactiveSequence">
      
      <ReactiveFallback name="NavPriorityRoot">
        <ReactiveSequence name="Priority0ManualOverride">
          <CheckManualOverride name="CheckManualOverride" branch="Priority0ManualOverride" />
          <!-- <ChangeMapAction name="SwitchToMainMapForManual"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026" /> -->
          <SetManualOverrideGoal name="SetManualOverrideGoal" />
          <NavigateToPoseAction name="NavigateManualOverrideGoal" />
          <WaitManual name="WaitManual" wait_duration_s="5.0" goal_radius="0.5" fallback_timeout_s="60.0" />
        </ReactiveSequence>

        <ReactiveSequence name="Priority1Survival">
          <CheckRetreatCondition name="CheckRetreatCondition"
                                 health_threshold="30"
                                 recovery_threshold="80"
                                 ammo_threshold="0"
                                 ammo_recovery_threshold="200"
                                 branch="Priority1Survival" />
          <!-- <ChangeMapAction name="SwitchToRetreatMap"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026_back" /> -->
          <SetCoordinate name="SetHomeGoal" goal="0" />
          <!-- <ForceSuccess>
            <ReactiveSequence name="StairsDescentFlow">
              <CheckInStairsZone name="CheckInStairsZone" />
              <SetStairsPosition name="SetStairsPosition" />
              <CheckNoAllyBelowStairs name="CheckNoAllyBelowStairs" />
              <DescendStairsAction name="DescendStairsAction" linear_y="2.0"
                           angular_z="0.0"
                           timeout="5.0" />
              <DescendStairsAction name="DescendStairsAction" linear_y="0.0"
                           angular_z="0.0"
                           timeout="0.5" />
            </ReactiveSequence>
          </ForceSuccess> -->
          <NavigateToPoseAction name="NavigateHome" />
        </ReactiveSequence>

        <!-- <ReactiveSequence name="Priority1_5TunnelRecovery">
          <CheckTimeInZone min_seconds="20.0" max_seconds="50.0" zone_name="transform_zone" />
          <SubTree ID="TunnelRecoverySubTree"
                   __shared_blackboard="true"
                   __autoremap="true" />
        </ReactiveSequence> -->

        <ReactiveSequence name="Priority2TargetAttack">
          <!-- <ChangeMapAction name="SwitchToMainMapForSpecial"
                             map_dir="src/navigation/navi2_bringup/maps/2026"
                             pcd_dir="src/utils/pcd2esdf/maps"
                             map_name="rmuc2026" /> -->
          <ReactiveSequence name="TargetPursuit">
            <CheckTargetLocked name="CheckTargetLocked" branch="Priority2TargetAttack" />
            <SetTargetCoordinate name="SetTargetCoordinate" tracing_dist="1.5"/>
            <NavigateToPoseAction name="NavigateTrackingTarget" />
          </ReactiveSequence>
        </ReactiveSequence>
        
        <ReactiveSequence name="Priority2.5_EmergencyHalt">
          <EmergencyStop name="EmergencyStop" />
          <NavigateToPoseAction name="NavigateToStop" />
        </ReactiveSequence>
        
        <ReactiveSequence name="Priority3SpecialResponse">
          <!-- <ChangeMapAction name="SwitchToMainMapForSpecial"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026" /> -->
          <ReactiveFallback name="SpecialResponseSelector">
            <ReactiveSequence name="NormalOutpostResponse">
              <CheckTacticalModeCondition name="CheckNormalMode" mode="normal" branch="NormalOutpostResponse" />
              <CheckOutpostRemained name="CheckOutpostRemained" branch="NormalOutpostResponse" />
              <CheckEngagedSafeResponse name="CheckEngagedSafeResponseForNav"
                                         stable_seconds="5.0"
                                         exit_mode="4"
                                         exit_blackboard_key="outpost_safe_cooldown_active"
                                         branch="NormalOutpostResponse" />
              <SetCoordinate name="SetEnemyOutpostGoal" goal="2" />
              <NavigateToPoseAction name="NavigateEnemyOutpost" />
            </ReactiveSequence>

            <ReactiveSequence name="DefendFortResponse">
              <CheckTacticalModeCondition name="CheckDefendMode" mode="defend" branch="DefendFortResponse" />
              <CheckOwnFortIdle name="CheckOwnFortIdle" branch="DefendFortResponse" />
              <SetCoordinate name="SetOwnFortGoal" goal="3" />
              <NavigateToPoseAction name="NavigateOwnFort" />
            </ReactiveSequence>

            <ReactiveSequence name="AttackFortResponse">
              <CheckTacticalModeCondition name="CheckAttackMode" mode="attack" branch="AttackFortResponse" />
              <!-- <CheckEnemyBaseLowHp name="CheckEnemyBaseLowHp" threshold="1000" branch="AttackFortResponse" /> -->
              <SetCoordinate name="SetEnemyFortGoal" goal="4" />
              <NavigateToPoseAction name="NavigateEnemyFort" />
            </ReactiveSequence>

            <ReactiveSequence name="EnergyResponse">
              <CheckCanActivateEnergy />
              <CheckEnergyActive branch="EnergyResponse" />
              <CheckTacticalModeCondition mode="attack" branch="EnergyResponse" />
              <CheckEngagedSafeResponse stable_seconds="5.0"
                                        exit_mode="4"
                                        exit_blackboard_key="energy_safe_cooldown_active"
                                        branch="EnergyResponse" />
              <SetCoordinate goal="5" />
              <NavigateToPoseAction name="NavigateEnergyZone" />
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveSequence name="Priority4TrackPatrol">
          <!-- <ChangeMapAction name="SwitchToMainMapForRoutine"
                           map_dir="src/navigation/navi2_bringup/maps/2026"
                           pcd_dir="src/utils/pcd2esdf/maps"
                           map_name="rmuc2026" /> -->
          <Sequence name="PatrolByTacticalMode">
            <SelectPatrolPoint name="SelectPatrolPoint" />
            <NavigateToPoseAction name="NavigatePatrolPoint" />
            <Wait name="WaitAtPatrolPoint" />
          </Sequence>
        </ReactiveSequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>