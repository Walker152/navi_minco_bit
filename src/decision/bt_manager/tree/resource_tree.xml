<root main_tree_to_execute="ResourceTree">
  <BehaviorTree ID="ResourceTree">
    <ReactiveFallback name="ResourcePriorityRoot">

      <!-- P0: 复活（最高优先级） -->
      <ReactiveSequence name="ReviveBranch">
        <CheckHealth threshold="0" mode="less" branch="ReviveBranch" />
        <ReactiveFallback>
          <!-- 免费复活优先 -->
          <Sequence name="FreeRevive">
            <CheckCanFreeResurrect />
            <RequestReviveAction revive_type="free" />
          </Sequence>
          <!-- 金币复活：在敌方半场或进攻战术 + 金币充足 -->
          <Sequence name="InstantRevive">
            <Fallback>
              <CheckInZone zone_name="enemy_defense" branch="InstantRevive" />
              <CheckTacticalModeCondition mode="attack" branch="InstantRevive" />
            </Fallback>
            <CheckCoinRemaining threshold="{instant_resurrect_cost}" mode="greater" branch="InstantRevive" />
            <RequestReviveAction revive_type="instant" />
          </Sequence>
        </ReactiveFallback>
      </ReactiveSequence>

      <ReactiveSequence name="AttackFortTransformHealthExchangeBranch">
        <CheckAttackFortHealthExchangeNeeded branch="AttackFortTransformHealthExchangeBranch" />
        <CheckCoinRemaining threshold="100" mode="greater" branch="AttackFortTransformHealthExchangeBranch" />
        <RequestRemoteHealthExchangeAction />
      </ReactiveSequence>

      <!-- <ReactiveSequence name="RemoteHealthExchangeBranch">
        <CheckEngagedStatus expected="false" branch="RemoteHealthExchange" />
        <CheckHealth threshold="30" mode="less" branch="RemoteHealthExchange" />
        <CheckCoinRemaining threshold="100" mode="greater" branch="RemoteHealthExchange" />
        <CheckRemoteExchangeCooldown cooldown_seconds="10.0"
                                     exchange_count_key="remote_health_exchange_count"
                                     branch="RemoteHealthExchange" />
        <RequestRemoteHealthExchangeAction />
      </ReactiveSequence> -->

      <!-- P1: 远程弹药兑换（交战中 + 弹药&lt;150 + 金币&gt;=150 + 6s冷却 + 有剩余次数） -->
      <!-- <ReactiveSequence name="RemoteAmmoExchangeBranch">
        <CheckEngagedStatus expected="true" branch="RemoteAmmoExchange" />
        <CheckAmmoLow ammo_threshold="50" branch="RemoteAmmoExchange" />
        <CheckCoinRemaining threshold="100" mode="greater" branch="RemoteAmmoExchange" />
        <CheckRemainingAmmoExchange branch="RemoteAmmoExchange" />
        <CheckRemoteExchangeCooldown cooldown_seconds="8.0"
                                     exchange_count_key="remote_ammo_exchange_count"
                                     branch="RemoteAmmoExchange" />
        <RequestRemoteAmmoExchangeAction />
      </ReactiveSequence> -->

      <!-- P2: 普通补给点弹药兑换（到家 + 弹药&lt;100 + 金币&gt;=10） -->
      <ReactiveSequence name="NormalAmmoExchangeBranch">
        <ReactiveFallback name="NormalAmmoExchangeConditions">
          <CheckInZone zone_name="own_supply_zone" branch="NormalAmmoExchange" />
          <CheckInZone zone_name="own_outpost_zone" branch="NormalAmmoExchange" />
        </ReactiveFallback>
        <CheckAmmoLow ammo_threshold="150" branch="NormalAmmoExchange" />
        <CheckCoinRemaining threshold="100" mode="greater" branch="NormalAmmoExchange" />
        <CheckNormalExchangeCooldown cooldown_seconds="1.0" branch="NormalAmmoExchange" />
        <AccumulateAmmoPurchase step="50" />
      </ReactiveSequence>

    </ReactiveFallback>
  </BehaviorTree>
</root>
