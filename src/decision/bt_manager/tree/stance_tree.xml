<root main_tree_to_execute="StanceTree">
  <BehaviorTree ID="StanceTree">
    <ReactiveSequence name="StanceTreeRoot">
      <CheckTunnelDeformation />
      <UpdateStanceDuration />
      
      <ReactiveFallback name="StancePriorityRoot">
        <ReactiveSequence name="ManualAttackTunnelDefendAlignBranch">
          <CheckTacticalModeCondition mode="attack" branch="ManualAttackTunnelDefendAlignBranch" />
          <CheckCrossZoneTransition branch="ManualAttackTunnelDefendAlignBranch" />
          <ChangeStance name="ChangeStanceManualAttackTunnelDefend" stance="DEFEND" />
          <TunnelGyroAlignAction branch="ManualAttackTunnelDefendAlignBranch" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="ManualAttackTunnelDefendAlignBranch" /> -->
        </ReactiveSequence>

        <ReactiveSequence name="MoveStanceNoGyroBranch">
          <CheckCrossZoneTransition branch="MoveStanceNoGyroBranch" />
          <ChangeStance name="ChangeStanceMoveNoGyro" stance="MOVE" />
          <TunnelGyroAlignAction branch="MoveStanceNoGyroBranch" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="MoveStanceNoGyroBranch" /> -->
        </ReactiveSequence>

        <!-- 强化姿态专门分支:非隧道场景下,若操作手强化覆盖生效(override_active && 能量 && 未超时),
             直接产出强化姿态并返回 SUCCESS,自动分支不会 tick。
             优先级:高于自动分支,低于隧道分支。
             此分支只覆盖姿态,不改变当前小陀螺策略。 -->
        <Sequence name="ManualEnhancedStanceBranch">
          <CheckManualStanceOverride branch="ManualEnhancedStanceBranch" />
          <ApplyManualStanceOverride name="ApplyManualEnhancedStance" />
        </Sequence>

        <ReactiveSequence name="AttackFortDefendGyroBranch">
          <CheckTacticalModeCondition mode="attack" branch="AttackFortDefendGyroBranch" />
          <ReactiveFallback name="EnemyFortStanceSelector">
            <Sequence name="ArrivedEnemyFortDefendGyro">
              <CheckInEnemyFortZone branch="ArrivedEnemyFortDefendGyro" />
              <SetGyroState use_gyro="true"
                            gyro_vel="80.0"
                            random_speed="false" />
              <Fallback name="FortDefendStanceSelector">
                <Sequence name="TryEnhancedDefend">
                  <CheckShouldEnhanceStance
                    target_stance="DEFEND"
                    accumulated_threshold="170"
                    fallback_game_time="60"
                    min_remaining_sec="1"
                    branch="FortDefend_Enhanced" />
                  <ChangeStance name="ChangeStanceArrivedEnemyFortEnhancedDefend" stance="ENHANCED_DEFEND" />
                </Sequence>
                <ChangeStance name="ChangeStanceArrivedEnemyFortDefend" stance="DEFEND" />
              </Fallback>
            </Sequence>
            <Sequence name="ApproachEnemyFortMoveZeroGyro">
              <Inverter>
                <CheckInEnemyFortZone branch="ApproachEnemyFortMoveZeroGyro" />
              </Inverter>
              <SetGyroState use_gyro="false"
                            gyro_vel="0.0"
                            random_speed="false" />
              <Fallback name="FortMoveStanceSelector">
                <Sequence name="TryEnhancedMove">
                  <CheckShouldEnhanceStance
                    target_stance="MOVE"
                    accumulated_threshold="170"
                    fallback_game_time="60"
                    min_remaining_sec="1"
                    branch="FortMove_Enhanced" />
                  <ChangeStance name="ChangeStanceApproachEnemyFortEnhancedMove" stance="ENHANCED_MOVE" />
                </Sequence>
                <ChangeStance name="ChangeStanceApproachEnemyFortMove" stance="MOVE" />
              </Fallback>
              <!-- 复用过洞分支已选定的航向目标,持续对齐直到该分支被 halt。 -->
              <TunnelGyroAlignAction branch="ApproachEnemyFortMoveZeroGyro"
                                     reuse_existing_target="true" />
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveFallback name="AbsoluteAttackBranch">
          <!-- 前哨站特殊响应:云台抬起时优先消耗强化攻击时长,不可用则回退普通攻击。 -->
          <Sequence name="OutpostEnhancedAttackBranch">
            <CheckOutpostTarget goal_distance_threshold="0.5"
                                require_pitch_up="true"
                                branch="OutpostEnhancedAttackBranch" />
            <SetGyroState use_gyro="true"
                          gyro_vel="40.0"
                          random_speed="false" />
            <Fallback name="OutpostAttackStanceSelector">
              <Sequence name="TryOutpostEnhancedAttack">
                <CheckShouldEnhanceStance
                  target_stance="ATTACK"
                  accumulated_threshold="170"
                  fallback_game_time="60"
                  min_remaining_sec="1"
                  force_if_available="true"
                  branch="OutpostAttack_Enhanced" />
                <ChangeStance name="ChangeStanceOutpostEnhancedAttack" stance="ENHANCED_ATTACK" />
              </Sequence>
              <ChangeStance name="ChangeStanceOutpostAttack" stance="ATTACK" />
            </Fallback>
          </Sequence>

          <Sequence name="HeatAttackBranch">
            <CheckHeat threshold="200" mode="greater" branch="HeatAttackBranch" />
            <!-- <CheckStanceEffectLimit target_stance="ATTACK" max_time_sec="180" /> -->
            <SetGyroState use_gyro="true"
                          gyro_vel="40.0"
                          random_speed="false" />
            <!-- <CheckStanceCooldown cooldown="5.0" branch="HeatAttackBranch" /> -->
            <Fallback name="AbsoluteAttackStanceSelector">
              <Sequence name="TryEnhancedAttack">
                <CheckShouldEnhanceStance
                  target_stance="ATTACK"
                  accumulated_threshold="170"
                  fallback_game_time="60"
                  min_remaining_sec="1"
                  branch="AbsoluteAttack_Enhanced" />
                <ChangeStance name="ChangeStanceAbsoluteEnhancedAttack" stance="ENHANCED_ATTACK" />
              </Sequence>
              <ChangeStance name="ChangeStanceAbsoluteAttack" stance="ATTACK" />
            </Fallback>
          </Sequence>
        </ReactiveFallback>

        <Sequence name="CombatAttackBranch">
          <CheckEngagedStatus expected="true" branch="CombatAttackBranch" />
          <CheckHealth threshold="50" mode="greater" branch="CombatAttackBranch" />
          <!-- <CheckStanceEffectLimit target_stance="ATTACK" max_time_sec="180" /> -->
          <SetGyroState use_gyro="true"
                        gyro_vel="80.0"
                        random_speed="false" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="CombatAttackBranch" /> -->
          <Fallback name="CombatAttackStanceSelector">
            <Sequence name="TryEnhancedAttack">
              <CheckShouldEnhanceStance
                target_stance="ATTACK"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1"
                branch="CombatAttack_Enhanced" />
              <ChangeStance name="ChangeStanceCombatEnhancedAttack" stance="ENHANCED_ATTACK" />
            </Sequence>
            <ChangeStance name="ChangeStanceCombatAttack" stance="ATTACK" />
          </Fallback>
        </Sequence>

        <Sequence name="DefendStanceBranch">
          <CheckEngagedStatus expected="true" branch="DefendStanceBranch" />
          <CheckHealth threshold="50" mode="less" branch="DefendStanceBranch" />
          <!-- <CheckStanceEffectLimit target_stance="DEFEND" max_time_sec="180" /> -->
          <SetGyroState use_gyro="true"
                        gyro_vel="80.0"
                        random_speed="false" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="DefendStanceBranch" /> -->
          <Fallback name="DefendStanceSelector">
            <Sequence name="TryEnhancedDefend">
              <CheckShouldEnhanceStance
                target_stance="DEFEND"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1"
                branch="Defend_Enhanced" />
              <ChangeStance name="ChangeStanceEnhancedDefend" stance="ENHANCED_DEFEND" />
            </Sequence>
            <ChangeStance name="ChangeStanceDefend" stance="DEFEND" />
          </Fallback>
        </Sequence>

        <Sequence name="MoveStanceGyroBranch">
          <Fallback name="MoveGyroConditions">
            <CheckCapacitorCapacity threshold="30" mode="less" branch="MoveStanceGyroBranch" />
            <CheckEngagedStatus expected="false" branch="MoveStanceGyroBranch" />
          </Fallback>
          <SetGyroState use_gyro="true"
                        gyro_vel="40.0"
                        random_speed="false" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="MoveStanceGyroBranch" /> -->
          <Fallback name="MoveStanceSelector">
            <Sequence name="TryEnhancedMove">
              <CheckShouldEnhanceStance
                target_stance="MOVE"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1"
                branch="Move_Enhanced" />
              <ChangeStance name="ChangeStanceEnhancedMove" stance="ENHANCED_MOVE" />
            </Sequence>
            <!-- <Sequence name="DisengagedHighlandDefendBranch">
              <Inverter>
                <CheckInZone zone_name="own_defend" branch="DisengagedHighlandDefendBranch" />
              </Inverter>
              <ChangeStance name="ChangeStanceDisengagedHighlandDefend" stance="DEFEND" />
            </Sequence> -->
            <ChangeStance name="ChangeStanceMoveWithGyro" stance="MOVE" />
          </Fallback>
        </Sequence>
        
        <Sequence name="DefaultDefendBranch">
          <SetGyroState use_gyro="true"
                        gyro_vel="80.0"
                        random_speed="false" />
          <!-- <CheckStanceCooldown cooldown="5.0" branch="DefaultDefendBranch" /> -->
          <Fallback name="DefaultDefendStanceSelector">
            <Sequence name="TryEnhancedDefend">
              <CheckShouldEnhanceStance
                target_stance="DEFEND"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1"
                branch="DefaultDefend_Enhanced" />
              <ChangeStance name="DefaultEnhancedDefendStance" stance="ENHANCED_DEFEND" />
            </Sequence>
            <ChangeStance name="DefaultDefendStance" stance="DEFEND" />
          </Fallback>
        </Sequence>

      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
