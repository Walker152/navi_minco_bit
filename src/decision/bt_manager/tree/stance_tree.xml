<root main_tree_to_execute="StanceTree">
  <BehaviorTree ID="StanceTree">
    <ReactiveFallback name="StancePriorityRoot">
      <Sequence name="AttackStance">
        <CheckAttackStanceCondition name="CheckAttackStanceCondition"
                                    high_heat_threshold="200"
                                    low_heat_threshold="80"
                                    attack_gyro_vel="80.0" />
        <ChangeStance name="ChangeStanceAttack" />
      </Sequence>

      <Sequence name="MoveStanceStrict">
        <CheckMoveStanceCondition name="CheckMoveStanceCondition" />
        <ChangeStance name="ChangeStanceMove" />
      </Sequence>

      <Sequence name="DefendStance">
        <CheckDefendStanceCondition name="CheckDefendStanceCondition" />
        <ChangeStance name="ChangeStanceDefend" />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>